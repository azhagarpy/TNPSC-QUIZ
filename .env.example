# Supabase project (Settings → API). The anon/publishable key is safe in the browser:
# row-level security and SECURITY DEFINER functions protect everything.
# Leave both empty to run the app in demo mode (solo practice with sample questions only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shown in the Terms and Privacy pages.
VITE_CONTACT_EMAIL=

# Region of your Supabase project, shown on the Privacy page (e.g. Mumbai, India).
VITE_DATA_REGION=

# Web push: `npm run push:setup` generates keys and fills VITE_VAPID_PUBLIC_KEY.
VITE_VAPID_PUBLIC_KEY=

# Optional: crash reports (Sentry DSN) and opt-in analytics (PostHog project key and host).
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server-side only, never shipped to the browser: Dashboard → Connect → Session pooler.
# Used by npm run db:apply, e2e:live and push:setup.
SUPABASE_DB_URL=
